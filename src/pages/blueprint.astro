---
import BaseLayout from '../layouts/BaseLayout.astro';
const principles = [['01', 'Why BLOSSOM exists', 'To create meaningful work, build useful technology, explore new ideas, solve real problems and grow a body of work where faith, creativity, technology and innovation can work together.'], ['02', 'How we work', 'We start small, operate with integrity, pursue excellent work and grow through genuine impact — not the appearance of scale.'], ['03', 'What we protect', 'People, trust, stewardship, thoughtful experimentation and the freedom to make work that is honest and useful.']];
---
<BaseLayout title="The BLOSSOM Blueprint" description="Read the evolving personal blueprint behind BLOSSOM — its mission, vision, values and way of working.">
  <main><section class="subpage-hero"><div class="section"><p class="eyebrow">Foundational document / v0.1</p><h1>The BLOSSOM <em>blueprint.</em></h1><p>The document beneath the language. A readable, evolving record of who BLOSSOM is, why it exists, and the principles that should guide its growth.</p><div class="document-meta"><span>Version 0.1</span><span>Last updated / September 2026</span><span>Status / Evolving</span></div><a href="/blueprint-download.pdf" download class="pill-button mt-8 inline-flex">Download blueprint <span class="arrow">↓</span></a></div></section><section class="section"><div class="principles-list">{principles.map(([number, title, copy]) => <article><span class="eyebrow">{number}</span><div><h2>{title}</h2><p>{copy}</p></div></article>)}</div><div class="blueprint-reading"><div><p class="eyebrow">Read online</p><h2>The long view.</h2></div><div class="reading-copy"><p><strong>Faith.</strong> BLOSSOM is Christian in its foundation: a commitment to integrity, service, stewardship and hope.</p><p><strong>Technology.</strong> We use technology as a tool for useful work — to help people learn, create, connect and solve problems.</p><p><strong>Innovation.</strong> We make room for questions, prototypes and experiments. An idea can be valuable before it is a product.</p><p><strong>Growth.</strong> We would rather become trustworthy than look impressive. Scale follows substance.</p></div></div><div class="empty-state"><p class="eyebrow">Sections still being assembled</p><p>Governance, financial stewardship, early collaborators, personal structure, project development process, collaboration principles and the full roadmap will be added from the source document rather than invented here.</p><a href="/join" class="text-link">Supply the next section <span>→</span></a></div></section></main>
</BaseLayout>
