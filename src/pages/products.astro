---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STATUS_VOCABULARY } from '../lib/content';
const projects = [
  { status: 'BUILDING', name: 'Bible Arena', type: 'Faith + Technology', description: 'A Bible-centered competitive learning platform.', href: '/products/bible-arena' },
  { status: 'BUILDING', name: 'BLOSSOM Digital Studio', type: 'Creative circle + Technology', description: 'The evolving home for the studio, its products and its people.', href: '/' },
  { status: 'RESEARCH', name: 'The Ideas Room', type: 'Innovation', description: 'A living archive for questions, prototypes and concepts before they become products.', href: '/innovation-lab' },
];
---
<BaseLayout title="BLOSSOM Products" description="Discover products and digital projects from the BLOSSOM studio.">
  <main><section class="subpage-hero"><div class="section subpage-hero-grid"><div><p class="eyebrow">Product directory / 2026</p><h1>Useful things,<br /><em>carefully built.</em></h1><p>Explore the products and digital projects moving through BLOSSOM. Every status is intentional. Every project is allowed to evolve.</p></div><img class="subpage-media" src="/media/product-tech.webp" alt="Developer working at a dark technology workspace" loading="eager" width="2400" height="1029" /></div></section><section class="section"><div class="directory-toolbar"><p class="eyebrow">{projects.length} projects in view</p><div>{['All', ...STATUS_VOCABULARY.slice(1, 3)].map((status) => <span>{status}</span>)}</div></div><div class="directory-list">{projects.map((project, index) => <a href={project.href} class="directory-row"><span class="directory-index">0{index + 1}</span><div><div class="project-meta"><span class={`directory-status ${project.status.toLowerCase()}`}>{project.status}</span><span>{project.type}</span></div><h2>{project.name}</h2><p>{project.description}</p></div><span class="directory-arrow">↗</span></a>)}</div></section></main>
</BaseLayout>
