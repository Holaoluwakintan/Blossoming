---
import BaseLayout from '../layouts/BaseLayout.astro';
const focus = [
  ['Current focus', 'Strengthening the digital studio, shaping Bible Arena’s first version, and growing the foundation around BLOSSOM.', 'BUILDING'],
  ['Next', 'Education and partnerships are planned areas of work, not active programs yet.', 'PROTOTYPE'],
  ['Exploring', 'New products, collaboration formats, creative projects and Innovation Lab experiments.', 'RESEARCH'],
  ['Long-term', 'A durable studio built with a global perspective with useful work, trusted relationships and room to grow.', 'IDEA'],
];
---
<BaseLayout title="What's Next | BLOSSOM" description="See what BLOSSOM is focused on now, preparing next, exploring, and considering for the long term.">
  <main><section class="subpage-hero"><div class="section"><p class="eyebrow">The direction</p><h1>What comes <em>next.</em></h1><p>A clear distinction between current work, planned work, exploration and long-term direction.</p></div></section><section class="section roadmap-page">{focus.map(([title, copy, status], index) => <article class="roadmap-block"><div class="roadmap-block-title"><span class={`roadmap-status status-${status.toLowerCase()}`}>{status}</span><h2>{title}</h2></div><div class="roadmap-page-card"><p>{copy}</p></div></article>)}</section></main>
</BaseLayout>
