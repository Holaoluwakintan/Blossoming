---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
const studio = [
  ['01', 'Products', 'Apps, websites, platforms and digital tools.', '/products'],
  ['02', 'Creative Studio', 'Books, stories, art, media and visual experiments.', '/books'],
  ['03', 'Innovation Lab', 'Research, prototypes and new concepts.', '/innovation-lab'],
  ['04', 'Creative circle', 'People contributing skills, ideas and resources.', '/join'],
  ['05', 'Education', 'Learning, technology, creativity and skill development — next.', '/whats-next'],
  ['06', 'Partnerships', 'Creators, teams and businesses — exploring.', '/whats-next'],
];
---

<BaseLayout title="BLOSSOM — Faith. Technology. Innovation." description="BLOSSOM is a creator-led studio building products, creative work, creative work and experiments at the intersection of faith, technology and innovation.">
  <main>
    <section class="hero-section hero-video-section">
      <video class="hero-video" autoplay muted loop playsinline poster="/media/hero-tech.webp" aria-label="Technology team collaborating in a modern workspace">
        <source src="/media/blossom-hero.webm" type="video/webm" /><source src="/media/blossom-hero.mp4" type="video/mp4" />
      </video><div class="hero-video-overlay"></div>
      <div class="section hero-inner hero-inner-left"><div class="hero-kicker" data-reveal><span class="live-mark"></span> BLOSSOM / PERSONAL STUDIO</div><h1 class="hero-title hero-title-left hero-words" aria-label="Building the systems, stories and technology for a more meaningful future."><span data-hero-word>Building</span> <span data-hero-word>the</span> <span data-hero-word>systems,</span><br /><span class="accent-word" data-hero-word>stories,</span> <span data-hero-word>and</span><br /><span data-hero-word>technology</span> <span data-hero-word>for</span><br /><em data-hero-word>a more meaningful future.</em></h1><p class="hero-copy hero-copy-left" data-reveal>Products, creative technology, visual work and experiments at the intersection of faith, technology and innovation.</p><div class="hero-actions hero-actions-left" data-reveal><a href="#studio" class="pill-button">Explore the studio <span class="arrow">↓</span></a><a href="/building" class="outline-button">See what we're building</a></div><div class="hero-scroll" data-reveal><span></span>Scroll to explore</div></div>
    </section>

    <section class="status-strip"><div class="status-strip-inner" data-stagger><div data-stagger-item><strong>01</strong><span>studio<br />in formation</span></div><div data-stagger-item><strong>03</strong><span>core<br />pillars</span></div><div data-stagger-item><strong>01</strong><span>flagship product<br />in development</span></div><div data-stagger-item><strong>01 →</strong><span>built with a global perspective<br />for the world</span></div></div></section>

    <section class="section intro-section reveal-section" data-reveal><div><p class="eyebrow">What is BLOSSOM?</p><h2 class="section-title">An independent studio with a personal point of view.</h2></div><div class="intro-body"><p class="lead-copy">We are building useful things, meaningful stories and the culture to hold them together.</p><p class="body-copy">BLOSSOM exists to create meaningful work, explore new questions, solve real problems and grow a body of work where faith, creativity, technology and innovation can work together.</p><a href="/blueprint" class="text-link">Read the BLOSSOM blueprint <span>→</span></a></div></section>

    <section id="studio" class="section studio-section"><div class="section-heading-row" data-reveal><div><p class="eyebrow">The studio</p><h2 class="section-title">One studio.<br /><em>Many ways to build.</em></h2></div><p class="body-copy heading-copy">Different forms of work. One shared conviction: good ideas deserve the care to become useful.</p></div><div class="studio-grid" data-stagger>{studio.map(([number, title, copy, href]) => <a href={href} class="studio-card" data-stagger-item><span class="eyebrow">{number}</span><h3>{title}</h3><p>{copy}</p><span class="card-arrow">↗</span></a>)}</div></section>

    <section class="dark-panel pillars-panel" data-pin><div class="section pinned-story"><div class="pinned-copy" data-pin-copy><p class="eyebrow light">The operating model</p><h2 class="section-title light-title">Three pillars.<br /><em>One philosophy.</em></h2><p class="body-copy light-copy">Faith gives us our foundation. Technology gives us the tools. Innovation gives us the courage to explore.</p></div><div class="pinned-visual" data-pin-visual><div class="pillar-orbit"></div><div class="pillar-orbit pillar-orbit-small"></div><span>FAITH<br />TECHNOLOGY<br />INNOVATION</span></div></div></section>

    <section class="feature-product-section"><div class="section feature-grid" data-reveal><div class="feature-product-copy"><p class="eyebrow">Flagship product / 01</p><h2 class="section-title">Bible Arena.</h2><p class="feature-kicker">Faith + Technology / BUILDING</p><p class="body-copy">A Bible-centered competitive learning platform designed to make Scripture discovery, practice and friendly competition more engaging.</p><div class="feature-points"><span>Quiz</span><span>Learning</span><span>Competition</span><span>Creative circle</span></div><a href="/products/bible-arena" class="pill-button">Explore Bible Arena <span class="arrow">→</span></a></div><a href="/products/bible-arena" class="feature-product-visual" data-scrub><img src="/media/product-tech.webp" alt="Developer workspace representing the technology behind Bible Arena" loading="lazy" width="2400" height="1029" /><div class="feature-visual-content"><span class="visual-label">BIBLE ARENA / 001</span><span class="arena-mark">BA</span><span class="visual-arrow">↗</span></div></a></div></section>

    <section class="section studio-section" data-reveal><div class="studio-image"><img src="/media/studio-tech.webp" alt="Technology team collaborating around screens in a creative studio" loading="lazy" width="2400" height="1350" /></div><div class="studio-copy"><p class="eyebrow">Creative studio</p><h2 class="section-title">Stories are part of the infrastructure.</h2><p class="body-copy">Books, visual work, reflections and experiments give BLOSSOM a language for the things technology alone cannot hold.</p><a href="/books" class="text-link">Explore the creative work <span>→</span></a></div></section>

    <section class="section roadmap-section" data-reveal><div class="section-heading-row"><div><p class="eyebrow">The journey</p><h2 class="section-title">Built. Building.<br /><em>Next.</em></h2></div><a href="/building" class="outline-button">Open the product lab →</a></div><div class="roadmap-grid" data-stagger><div class="roadmap-column" data-stagger-item><span class="roadmap-status status-built">Built</span><h3>What already exists.</h3><p class="body-copy">Creative work, books, visual stories, reflections and the first version of this digital home.</p></div><div class="roadmap-column active" data-stagger-item><span class="roadmap-status status-building">Building</span><h3>What is actively moving.</h3><p class="body-copy">Bible Arena, the Innovation Lab, this studio and the people around it.</p></div><div class="roadmap-column" data-stagger-item><span class="roadmap-status status-next">Next</span><h3>What we are preparing.</h3><p class="body-copy">New products, education, partnerships and experiments — committed to carefully, not casually.</p></div></div></section>

    <section class="section join-section" data-reveal><div class="join-panel"><div><p class="eyebrow">Build with us</p><h2>The work is open to people who want to contribute.</h2><p>Find your place in the work — as a contributor, collaborator, beta tester or partner.</p></div><img src="/media/join-tech.webp" alt="Technology collaborators working around a laptop" loading="lazy" width="2400" height="1600" /><a href="/join" class="pill-button-light">Find your way in <span class="arrow">→</span></a></div></section>

    <section class="closing-section"><div class="section" data-reveal><p class="eyebrow">The next chapter is open</p><h2>Built with a global perspective.<br /><em>Designed for the world.</em></h2><a href="/join" class="pill-button-light">Start a conversation <span class="arrow">→</span></a></div></section>
  </main>
</BaseLayout>
