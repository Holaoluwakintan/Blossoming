---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = [{ title: 'BLOSSOM Digital Studio', category: 'Website', status: 'LIVE', problem: 'BLOSSOM needed a public home that could explain the studio honestly.', idea: 'Build a digital studio around identity, proof, story and participation.', build: 'Astro site with product, blueprint, building and creative circle pathways.', result: 'A living public home for the studio and its work.', lessons: 'Start with a clear structure, then let the system grow.', href: '/' }, { title: 'BLOSSOM Creative Work', category: 'Publications', status: 'LIVE', problem: 'Ideas need forms people can read, see and return to.', idea: 'Use books and creative work as part of the studio’s foundation.', build: 'A growing shelf of publications, stories and reflections.', result: 'A creative body of work that gives BLOSSOM a language beyond products.', lessons: 'Meaningful work can begin before the whole system is complete.', href: '/books' }];
---
<BaseLayout title="Built by BLOSSOM" description="Read honest case studies about websites, publications and creative work built by BLOSSOM.">
  <main><section class="subpage-hero"><div class="section"><p class="eyebrow">Case studies / proof</p><h1>Built by <em>BLOSSOM.</em></h1><p>Real work, described plainly. No invented clients, milestones or scale.</p></div></section><section class="section roadmap-page">{projects.map((project, index) => <article class="case-study-card"><div class="case-study-head"><span class="eyebrow">0{index + 1} / {project.category}</span><span class="roadmap-status status-live">{project.status}</span></div><h2>{project.title}</h2><div class="case-study-grid"><div><span class="eyebrow">The Problem</span><p>{project.problem}</p></div><div><span class="eyebrow">The Idea</span><p>{project.idea}</p></div><div><span class="eyebrow">The Build</span><p>{project.build}</p></div><div><span class="eyebrow">The Result</span><p>{project.result}</p></div><div><span class="eyebrow">What We Learned</span><p>{project.lessons}</p></div></div><a href={project.href} class="text-link">Open the work <span>→</span></a></article>)}</section></main>
</BaseLayout>
