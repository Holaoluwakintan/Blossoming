---
import NewsletterForm from '../components/NewsletterForm.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'BLOSSOM — Faith. Technology. Innovation.',
  description = 'BLOSSOM is a creator-led studio building meaningful work at the intersection of faith, technology, and innovation.',
  image = '/og-image.png',
  canonical,
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = 'https://blossom-website-phi.vercel.app';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Olaoluwa Michael',
  alternateName: 'BLOSSOM',
  url: siteUrl,
  description,
  knowsAbout: ['Faith', 'Technology', 'Innovation'],
};
const schemaItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [defaultStructuredData];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Olaoluwa Michael" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#090c12" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BLOSSOM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {schemaItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="font-sans antialiased overflow-x-hidden bg-[#090c12] text-[#f5f4f0]">
    <div class="page-progress" aria-hidden="true"><span></span></div>
    <header class="site-header">
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/" class="brand" aria-label="BLOSSOM home"><span class="brand-mark">B</span><span class="brand-word">BLOSSOM</span><span class="brand-sub">/ STUDIO</span></a>
        <div class="desktop-nav"><a href="/products">Products</a><a href="/building">Building</a><a href="/blueprint">Blueprint</a><a href="/journal">Build notes</a></div>
        <div class="nav-actions"><a href="/join" class="nav-join">Work with me <span>↗</span></a><button id="menu-button" class="menu-button" aria-expanded="false" aria-controls="mobile-menu">Menu</button></div>
      </nav>
      <div id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation"><a href="/products">Products</a><a href="/building">Building</a><a href="/blueprint">Blueprint</a><a href="/journal">Build notes</a><a href="/join" class="mobile-join">Work with me →</a></div>
    </header>
    <main class="page-transition"><slot /></main>
    <section class="newsletter-wrap" data-reveal><NewsletterForm compact /></section>
<footer class="site-footer"><div class="footer-main"><div><a href="/" class="footer-brand">BLOSSOM</a><p>A creator-led studio building ideas, technology, stories and solutions designed to matter.</p></div><div><span class="footer-label">BLOSSOM</span><a href="/blueprint">Blueprint</a><a href="/journey">Journey</a><a href="/join">Collaborate</a></div><div><span class="footer-label">BUILD</span><a href="/products">Products</a><a href="/building">What we are building</a><a href="/built-by-blossom">Built by BLOSSOM</a><a href="/innovation-lab">Innovation Lab</a></div><div><span class="footer-label">CONNECT</span><a href="/join">Join</a><a href="/whats-next">What is next</a><a href="mailto:michaelolaoluwag@gmail.com">Collaborate</a></div><div><span class="footer-label">EXPLORE</span><a href="/journal">Build Notes</a><a href="/books">Creative work</a><a href="mailto:michaelolaoluwag@gmail.com">michaelolaoluwag@gmail.com</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} BLOSSOM / Independent studio</span><span>Faith · Technology · Innovation</span></div></footer>
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
      let lenis;
      let cleanup = () => {};

      function initMotion() {
        cleanup();
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.classList.toggle('reduced-motion', reduced);
        const mobile = window.matchMedia('(max-width: 700px)').matches;
        if (reduced) return;

        lenis = new Lenis({ duration: 1.15, smoothWheel: true, syncTouch: false });
        lenis.on('scroll', ScrollTrigger.update);
        const raf = (time) => lenis?.raf(time * 1000);
        gsap.ticker.add(raf);
        gsap.ticker.lagSmoothing(0);

        const ctx = gsap.context(() => {
          gsap.fromTo('.page-transition', { opacity: 0 }, { opacity: 1, duration: .7, ease: 'power2.out' });
          const heroWords = document.querySelectorAll('[data-hero-word]');
          if (heroWords.length) gsap.fromTo(heroWords, { opacity: 0, y: 34, filter: 'blur(8px)' }, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.05, stagger: .075, ease: 'power3.out', delay: .12 });
          document.querySelectorAll('[data-reveal]').forEach((el) => {
            gsap.fromTo(el, { opacity: 0, y: 34 }, { opacity: 1, y: 0, duration: .95, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 86%', once: true } });
          });
          document.querySelectorAll('[data-stagger]').forEach((group) => {
            const children = group.querySelectorAll('[data-stagger-item]');
            gsap.fromTo(children, { opacity: 0, y: 28 }, { opacity: 1, y: 0, duration: .8, stagger: .1, ease: 'power3.out', scrollTrigger: { trigger: group, start: 'top 82%', once: true } });
          });
          document.querySelectorAll('[data-scrub]').forEach((el) => {
            gsap.to(el, { scale: mobile ? 1.03 : 1.14, yPercent: mobile ? -2 : -8, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 1.2 } });
          });
          document.querySelectorAll('[data-pin]').forEach((el) => {
            const copy = el.querySelector('[data-pin-copy]');
            const visual = el.querySelector('[data-pin-visual]');
            const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: 'top top', end: '+=900', pin: true, scrub: 1.1, anticipatePin: 1 } });
            if (copy) tl.fromTo(copy, { y: 40, opacity: .3 }, { y: 0, opacity: 1, duration: .35 }).to(copy, { y: -40, opacity: .15, duration: .65 });
            if (visual) tl.fromTo(visual, { scale: .8, rotate: -4 }, { scale: 1.08, rotate: 2, duration: 1 }, 0);
          });
          const progress = document.querySelector('.page-progress span');
          if (progress) gsap.to(progress, { scaleX: 1, ease: 'none', transformOrigin: 'left center', scrollTrigger: { start: 'top top', end: 'max', scrub: .2 } });
        });
        cleanup = () => { ctx.revert(); gsap.ticker.remove(raf); lenis?.destroy(); lenis = undefined; };
        ScrollTrigger.refresh();
      }

      document.addEventListener('astro:page-load', initMotion);
      initMotion();
      const button = document.getElementById('menu-button'); const menu = document.getElementById('mobile-menu');
      button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') === 'true'; button.setAttribute('aria-expanded', String(!open)); menu?.classList.toggle('open', !open); });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); menu?.classList.remove('open'); }));
    </script>
  </body>
</html>
